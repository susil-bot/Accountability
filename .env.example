# ── Core ─────────────────────────────────────────────
# NODE_ENV is set by the scripts (dev/build/start) — do not set it here.
APP_URL=http://localhost:3000
API_PORT=4000

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://accountability:accountability@localhost:5432/accountability?schema=public
# Used only by integration tests (created automatically by `npm run test:integration`)
TEST_DATABASE_URL=postgresql://accountability:accountability@localhost:5432/accountability_test?schema=public

# Background jobs run on Postgres (no Redis). Set to "false" on HTTP-only replicas;
# lazy catch-up on page load keeps the app correct even with no worker running.
JOBS_ENABLED=true

# Only set to true when the API is reachable solely through Cloudflare (Tunnel): rate limits then use CF-Connecting-IP.
TRUST_CLOUDFLARE=false

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=7

# Where the web app proxies /api/v1/* (next dev rewrite / static preview server).
# In production the Cloudflare Pages Function uses its own API_ORIGIN setting.
API_INTERNAL_URL=http://localhost:4000

# Evidence storage. Browsers upload straight to storage with short-lived signed URLs.
#  local → files under STORAGE_LOCAL_DIR, signed URLs served by the API (dev, tests, single VM)
#  r2    → Cloudflare R2 (S3 API). Needs R2_ACCOUNT_ID, STORAGE_BUCKET, STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY
#          and a bucket CORS rule allowing PUT/GET from APP_URL with the Content-Type header.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNING_SECRET=change-me-signing-secret
R2_ACCOUNT_ID=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
USER_STORAGE_QUOTA_MB=200

# Later phases
OPENAI_API_KEY=
EMAIL_API_KEY=

# Web Push (optional, free). Generate once with: npm run vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
