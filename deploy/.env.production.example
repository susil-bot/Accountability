# Production settings for deploy/docker-compose.prod.yml. Create the real file with: ./make-env.sh
# Never commit deploy/.env.production.

# Public web address (Cloudflare Pages), e.g. https://accountability.pages.dev
APP_URL=
# Hostname Caddy serves the API on: <ip-with-dashes>.sslip.io or your own api hostname
API_HOST=
ACME_EMAIL=

POSTGRES_PASSWORD=
JWT_SECRET=
STORAGE_SIGNING_SECRET=
# Must match ORIGIN_SECRET in the Cloudflare Pages project
ORIGIN_SECRET=
SESSION_TTL_DAYS=7

# Uploaded photos: "local" (on this server's disk, included in backups) or "r2"
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional: also copy nightly backups to this R2 bucket (needs the R2 keys above)
BACKUP_BUCKET=

# Web Push (free). Generated by make-env.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
